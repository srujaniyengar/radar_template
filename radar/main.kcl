// Partial sensor-holder assembly — pedestal is not validated
// Three valid printed parts only; pedestal.kcl remains a failed draft, not an assembled part.
@settings(defaultLengthUnit = mm, kclVersion = 3.0)

import "plate.kcl" as platePart
import "hub.kcl" as hubPart
import "bottomCover.kcl" as coverPart
import boxHeight, footAirGap, footThickness, socketHeight, housingWidth, plugStandOff, bridgeTop from "dimensions.kcl"

panAngle = 0deg // Intended sweep -100..100; hardware and cables are not modeled.
plateQuarterTurn = 0deg // 0=row, 90=column; plug symmetry also permits 180 and 270.
hubDatum = boxHeight + footAirGap
plateDatumX = housingWidth / 2 + plugStandOff + bridgeTop
plateDatumZ = footThickness + socketHeight

bottomCover = coverPart
hub = hubPart
  |> rotate(axis = Z, angle = panAngle, global = true)
  |> translate(z = hubDatum, global = true)
plate = platePart
  |> rotate(axis = Y, angle = -90deg, global = true)
  |> rotate(axis = X, angle = -90deg + plateQuarterTurn, global = true)
  |> translate(x = plateDatumX, z = plateDatumZ, global = true)
  |> rotate(axis = Z, angle = panAngle, global = true)
  |> translate(z = hubDatum, global = true)
